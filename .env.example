# URL pública final do site, sem barra no final (ex.: https://www.seudominio.com.br).
# TODO: preencher quando o domínio próprio estiver definido.
# Se vazio, usa automaticamente a URL de produção da Vercel.
NEXT_PUBLIC_SITE_URL=

# ID do Google Analytics 4 (ex.: G-XXXXXXXXXX). Opcional.
# Sem ele, o Analytics e o banner de cookies não são carregados.
NEXT_PUBLIC_GA_ID=

# Código de verificação do Google Search Console (somente o valor do content). Opcional.
NEXT_PUBLIC_GSC_VERIFICATION=
